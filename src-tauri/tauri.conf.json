{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardloader",
  "version": "../package.json",
  "identifier": "com.ximilar.cardloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cardloader",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Scan and analyse collectible cards with Ximilar",
    "longDescription": "Cardloader scans trading, sports and comic cards from a folder or a document scanner, identifies and grades them with the Ximilar API, and keeps every run as a session — locally and in Ximilar Cards Cloud.",
    "publisher": "Ximilar",
    "copyright": "© Ximilar s.r.o. — Apache-2.0",
    "homepage": "https://www.ximilar.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
